  "pattern": {
    "id": "shared-cue-sheet",
    "order": 29,
    "title": "画音共用节拍表",
    "types": [
      "rhythm",
      "sound"
    ],
    "carriers": [
      "video"
    ],
    "orients": [
      "landscape"
    ],
    "summary": "依次重放三片的密集节点段，在画面上用中文标出当前节点，并沿用原片音轨。重放内容还包括逐帧手绘的旋转、爆炸与逐笔书写，以及线条艺术的停笔续笔段。",
    "mechanism": "画面与配乐读取同一份 film/cues.json，将动作和对应音效定位在同一时间轴；三个来源依次重放，说明层显示当前节点的中文名称。 逐帧手绘共用划火、跳跃、爆炸与书写节点；线条艺术额外从同一路径导出笔尖速度与转角，供笔触响度和结构音使用。",
    "trigger": "共享时间表中的画面与声音节点到达时。",
    "effect": "同一节点同时决定原片画面的动作位置与对应音轨时刻，节点说明随来源和时间更新。",
    "timing": [
      {
        "name": "画面时间基准",
        "value": "1920×1080、30fps；原作帧号除以30换算为秒。"
      },
      {
        "name": "扁平矢量落点",
        "value": "180、195、210、225帧；6、6.5、7、7.5秒。"
      },
      {
        "name": "包豪斯级联",
        "value": "120BPM；R1=6、R2=6.5、R3=7.2、R4=7.5秒，8秒定格。"
      },
      {
        "name": "像素开箱节点",
        "value": "6秒震箱；6.2、6.3秒箱盖跳动；6.4秒开箱；6.8秒接物；7.2秒片名。"
      },
      {
        "name": "逐帧手绘节点",
        "value": "120BPM、24fps；6.5秒爆炸，7.25–8.5秒每0.125秒一笔。"
      },
      {
        "name": "线条路径数据",
        "value": "速度差分dt=1/600；按120Hz采样，CORN[i]>0.05且TD[i]-lastT>0.05时导出转角。"
      },
      {
        "name": "总时长",
        "value": "12.892秒；保留原三段，末尾追加逐帧手绘和线条艺术。"
      }
    ],
    "useCases": [
      "原片动作与音效节点对照",
      "多来源节拍表展示",
      "用逐帧手绘的动作表和线条艺术共享的笔尖速度、转角数据同步画面与声音。"
    ],
    "avoid": [
      "片段边界无缝循环"
    ],
